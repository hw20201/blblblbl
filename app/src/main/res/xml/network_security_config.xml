<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Remote subscriptions and scripts require TLS. Native Mihomo providers use their own stack. -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Exact names only. Loopback keeps the local mixed-port proxy working; ip-api.com's free
         endpoint has no HTTPS, so it is the single cleartext exception for the exit-IP lookup. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">ip-api.com</domain>
    </domain-config>
</network-security-config>
