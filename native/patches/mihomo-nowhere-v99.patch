+
+func TestNowherePacketSetupCancellation(t *testing.T) {
+	for _, name := range []string{"deadline", "close", "deadline-reset"} {
+		t.Run(name, func(t *testing.T) {
+			started := make(chan struct{})
+			canceled := make(chan struct{})
+			release := make(chan struct{}, 1)
+			defer close(release)
+			client, err := nowhere.NewClient(nowhere.Options{
+				SharedKey: "0123456789abcdef0123456789abcdef", TLSConfig: &tls.Config{},
+				DialStream: func(ctx context.Context) (net.Conn, error) {
+					close(started)
+					<-ctx.Done()
+					if name == "deadline-reset" {
+						close(canceled)
+						<-release
+					}
+					return nil, ctx.Err()
+				},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer client.Close()
+			var budget atomic.Int64
+			association := newNowherePacketConn(context.Background(), client, &budget)
+			defer association.Close()
+			result := make(chan error, 1)
+			go func() {
+				_, err := association.WriteTo([]byte("packet"), &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 53})
+				result <- err
+			}()
+			select {
+			case <-started:
+			case <-time.After(time.Second):
+				t.Fatal("flow setup did not start")
+			}
+			want := os.ErrDeadlineExceeded
+			if name == "close" {
+				association.Close()
+				want = net.ErrClosed
+			} else {
+				_ = association.SetWriteDeadline(time.Now().Add(-time.Second))
+				if name == "deadline-reset" {
+					select {
+					case <-canceled:
+					case <-time.After(time.Second):
+						t.Fatal("deadline did not cancel setup")
+					}
+					_ = association.SetWriteDeadline(time.Time{})
+					release <- struct{}{}
+				}
+			}
+			select {
+			case err := <-result:
+				if !errors.Is(err, want) {
+					t.Fatalf("setup returned %v, want %v", err, want)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("flow setup did not cancel")
+			}
+		})
+	}
+}
+
+func BenchmarkNowherePacketCachedWrite(b *testing.B) {
+	var budget atomic.Int64
+	association := newNowherePacketConn(context.Background(), nil, &budget)
+	defer association.Close()
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 53}
+	association.flows[addr.AddrPort().String()] = &nowhereFlow{Conn: &nowhereDiscardConn{}}
+	payload := make([]byte, 1200)
+	b.SetBytes(int64(len(payload)))
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if n, err := association.WriteTo(payload, addr); err != nil || n != len(payload) {
+			b.Fatal(n, err)
+		}
+	}
+}
