diff --git a/pkg/nowhere/client_test.go b/pkg/nowhere/client_test.go
new file mode 100644
index 0000000..a7888c9
--- /dev/null
+++ b/pkg/nowhere/client_test.go
@@ -0,0 +1,122 @@
+package nowhere
+
+import (
+	"bytes"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"testing"
+)
+
+type uotReadConn struct {
+	net.Conn
+	reader io.Reader
+}
+
+func (c *uotReadConn) Read(p []byte) (int, error) { return c.reader.Read(p) }
+
+func TestUOTConnReadPacketBoundaries(t *testing.T) {
+	packets := [][]byte{bytes.Repeat([]byte("a"), 4096), nil, []byte("short buffer"), []byte("z"), nil}
+	var wire bytes.Buffer
+	for _, packet := range packets {
+		if err := WriteUOTPacket(&wire, packet); err != nil {
+			t.Fatal(err)
+		}
+	}
+	conn := &uotConn{Conn: &uotReadConn{reader: &wire}}
+	for i, packet := range packets {
+		out := make([]byte, 8192)
+		wantErr := error(nil)
+		if i == 2 {
+			out = out[:3]
+			wantErr = io.ErrShortBuffer
+		}
+		n, err := conn.Read(out)
+		if !errors.Is(err, wantErr) || n != min(len(packet), len(out)) || !bytes.Equal(out[:n], packet[:n]) {
+			t.Fatalf("packet %d: got %q, %v; want %q, %v", i, out[:n], err, packet, wantErr)
+		}
+	}
+	if n, err := conn.Read(make([]byte, 1)); n != 0 || err != io.EOF {
+		t.Fatal("packet boundary EOF", n, err)
+	}
+}
+
+type uotReadStep struct {
+	data []byte
+	err  error
+}
+
+type uotScriptedReader struct{ steps []uotReadStep }
+
+func (r *uotScriptedReader) Read(p []byte) (int, error) {
+	if len(r.steps) == 0 {
+		return 0, io.EOF
+	}
+	step := &r.steps[0]
+	n := copy(p, step.data)
+	step.data = step.data[n:]
+	if len(step.data) != 0 {
+		return n, nil
+	}
+	err := step.err
+	r.steps = r.steps[1:]
+	return n, err
+}
+
+func TestUOTConnReadResumesAfterDeadline(t *testing.T) {
+	r := &uotScriptedReader{steps: []uotReadStep{
+		{data: []byte{0}},
+		{err: os.ErrDeadlineExceeded},
+		{data: []byte{4}},
+		{data: []byte("da")},
+		{err: os.ErrDeadlineExceeded},
+		{data: []byte("ta")},
+		{data: []byte{0, 1, 'z'}},
+	}}
+	conn := &uotConn{Conn: &uotReadConn{reader: r}}
+	out := make([]byte, 16)
+	for i := 0; i < 2; i++ {
+		if n, err := conn.Read(out); n != 0 || !errors.Is(err, os.ErrDeadlineExceeded) {
+			t.Fatal("partial packet deadline", n, err)
+		}
+	}
+	for _, want := range []string{"data", "z"} {
+		n, err := conn.Read(out)
+		if err != nil || string(out[:n]) != want {
+			t.Fatal("packet after deadline", n, err, string(out[:n]))
+		}
+	}
+}
+
+type uotRepeatingReader struct {
+	packet []byte
+	offset int
+}
+
+func (r *uotRepeatingReader) Read(p []byte) (int, error) {
+	n := copy(p, r.packet[r.offset:])
+	r.offset += n
+	if r.offset == len(r.packet) {
+		r.offset = 0
+	}
+	return n, nil
+}
+
+func BenchmarkUOTConnRead(b *testing.B) {
+	payload := make([]byte, 1200)
+	var wire bytes.Buffer
+	if err := WriteUOTPacket(&wire, payload); err != nil {
+		b.Fatal(err)
+	}
+	conn := &uotConn{Conn: &uotReadConn{reader: &uotRepeatingReader{packet: wire.Bytes()}}}
+	out := make([]byte, len(payload))
+	b.ReportAllocs()
+	b.SetBytes(int64(len(payload)))
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if n, err := conn.Read(out); err != nil || n != len(payload) {
+			b.Fatal(n, err)
+		}
+	}
+}
