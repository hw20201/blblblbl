+
+func TestMorphPacketConcurrentReads(t *testing.T) {
+	key := derive("key").udpReceive
+	payload := bytes.Repeat([]byte("packet"), 200)
+	wire := make([]byte, nonceLen+len(payload))
+	cipher, _ := chacha20.NewUnauthenticatedCipher(key[:], wire[:nonceLen])
+	cipher.XORKeyStream(wire[nonceLen:], payload)
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 443}
+	conn := &packetConn{PacketConn: &morphPacketSocket{wire: wire, addr: addr}, receive: key}
+	var wg sync.WaitGroup
+	for i := 0; i < 8; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			out := make([]byte, len(payload))
+			for j := 0; j < 32; j++ {
+				n, from, err := conn.ReadFrom(out)
+				if err != nil || from != addr || !bytes.Equal(out[:n], payload) {
+					t.Error("concurrent packet read corrupted payload", n, err)
+					return
+				}
+			}
+		}()
+	}
+	wg.Wait()
+}
