+type clientWithoutEdns0Subnet struct {
+	dnsClient
+}
+
+func (c clientWithoutEdns0Subnet) ExchangeContext(ctx context.Context, message *D.Msg) (*D.Msg, error) {
+	message = message.Copy()
+	stripEdns0Subnet(message)
+	response, err := c.dnsClient.ExchangeContext(ctx, message)
+	if err == nil && response != nil {
+		response = response.Copy()
+		stripEdns0Subnet(response)
+	}
+	return response, err
+}
+
+func (c clientWithoutEdns0Subnet) Unwrap() dnsClient { return c.dnsClient }
+
+func stripEdns0Subnet(message *D.Msg) {
+	for _, record := range message.Extra {
+		opt, ok := record.(*D.OPT)
+		if !ok {
+			continue
+		}
+		opt.Option = slices.DeleteFunc(opt.Option, func(option D.EDNS0) bool {
+			return option.Option() == D.EDNS0SUBNET
+		})
+	}
+}
