+// isProxyChain checks the leaf adapter. Mihomo appends group wrappers after the outbound leaf.
+// Empty chains and built-in direct-compatible outbounds are deliberately not counted as proxy traffic.
+func isProxyChain(chain C.Chain) bool {
+	leaf := strings.TrimSpace(chain.Last())
+	if leaf == "" {
+		return false
+	}
+	switch {
+	case strings.EqualFold(leaf, "DIRECT"), strings.EqualFold(leaf, "COMPATIBLE"),
+		strings.EqualFold(leaf, "PASS"), strings.EqualFold(leaf, "PASS-RULE"),
+		strings.EqualFold(leaf, "REJECT"), strings.EqualFold(leaf, "REJECT-DROP"):
+		return false
+	default:
+		return true
+	}
+}
