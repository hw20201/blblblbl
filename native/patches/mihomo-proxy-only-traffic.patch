+func (c *proxyTrafficTestConn) ProviderChains() C.Chain     { return nil }
+func (c *proxyTrafficTestConn) RemoteDestination() string   { return "example.test:443" }
+func (c *proxyTrafficTestConn) Read(b []byte) (int, error)  { return len(b), nil }
+func (c *proxyTrafficTestConn) Write(b []byte) (int, error) { return len(b), nil }
+
+type proxyTrafficTestPacketConn struct {
+	C.PacketConn
+	chain C.Chain
+}
+
+func (c *proxyTrafficTestPacketConn) Chains() C.Chain           { return c.chain }
+func (c *proxyTrafficTestPacketConn) ProviderChains() C.Chain   { return nil }
+func (c *proxyTrafficTestPacketConn) RemoteDestination() string { return "example.test:443" }
+func (c *proxyTrafficTestPacketConn) ReadFrom(b []byte) (int, net.Addr, error) {
+	return len(b), nil, nil
+}
+func (c *proxyTrafficTestPacketConn) WriteTo(b []byte, _ net.Addr) (int, error) {
+	return len(b), nil
+}
+
+func newProxyTrafficTestManager() *Manager {
+	return &Manager{
+		uploadTemp:         atomic.NewInt64(0),
+		downloadTemp:       atomic.NewInt64(0),
+		uploadBlip:         atomic.NewInt64(0),
+		downloadBlip:       atomic.NewInt64(0),
+		uploadTotal:        atomic.NewInt64(0),
+		downloadTotal:      atomic.NewInt64(0),
+		proxyUploadTotal:   atomic.NewInt64(0),
+		proxyDownloadTotal: atomic.NewInt64(0),
+	}
+}
+
+func TestProxyTrafficCountersExcludeDirectTCPAndUDP(t *testing.T) {
+	for _, transport := range []string{"tcp", "udp"} {
+		for _, tc := range []struct {
+			name      string
+			chain     C.Chain
+			proxyOnly bool
+		}{
+			{"proxy outbound", C.Chain{"Japan-01", "Auto"}, true},
+			{"DIRECT outbound", C.Chain{"DIRECT", "Auto"}, false},
+			{"COMPATIBLE outbound", C.Chain{"COMPATIBLE", "Auto"}, false},
+			{"REJECT outbound", C.Chain{"REJECT", "Auto"}, false},
+			{"REJECT-DROP outbound", C.Chain{"REJECT-DROP", "Auto"}, false},
+		} {
+			t.Run(transport+"/"+tc.name, func(t *testing.T) {
+				manager := newProxyTrafficTestManager()
+				if transport == "tcp" {
+					tracker := NewTCPTracker(&proxyTrafficTestConn{chain: tc.chain}, manager, &C.Metadata{}, nil, 3, 5, true)
+					if _, err := tracker.Write(make([]byte, 7)); err != nil {
+						t.Fatal(err)
+					}
+					if _, err := tracker.Read(make([]byte, 11)); err != nil {
+						t.Fatal(err)
+					}
+				} else {
+					tracker := NewUDPTracker(&proxyTrafficTestPacketConn{chain: tc.chain}, manager, &C.Metadata{}, nil, 3, 5, true)
+					if _, err := tracker.WriteTo(make([]byte, 7), nil); err != nil {
+						t.Fatal(err)
+					}
+					if _, _, err := tracker.ReadFrom(make([]byte, 11)); err != nil {
+						t.Fatal(err)
+					}
+				}
+				if up, down := manager.Total(); up != 10 || down != 16 {
+					t.Fatalf("all-traffic total=(%d,%d), want (10,16)", up, down)
+				}
+				wantUp, wantDown := int64(0), int64(0)
+				if tc.proxyOnly {
+					wantUp, wantDown = 10, 16
+				}
+				if up, down := manager.ProxyTotal(); up != wantUp || down != wantDown {
+					t.Fatalf("proxy total=(%d,%d), want (%d,%d)", up, down, wantUp, wantDown)
+				}
+			})
+		}
+	}
+}
+
+func TestIsProxyChainUsesLeafOutboundAndExcludesDirect(t *testing.T) {
+	cases := []struct {
+		name  string
+		chain C.Chain
+		want  bool
+	}{
+		{"proxy leaf with group wrapper", C.Chain{"Japan-01", "Auto"}, true},
+		{"direct leaf with group wrapper", C.Chain{"DIRECT", "Auto"}, false},
+		{"compatible direct leaf", C.Chain{"COMPATIBLE", "Auto"}, false},
+		{"pass is not a proxy", C.Chain{"PASS"}, false},
+		{"pass rule is not a proxy", C.Chain{"PASS-RULE"}, false},
+		{"reject is not a proxy", C.Chain{"REJECT"}, false},
+		{"reject drop is not a proxy", C.Chain{"REJECT-DROP"}, false},
+		{"empty chain", C.Chain{}, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := isProxyChain(tc.chain); got != tc.want {
+				t.Fatalf("isProxyChain(%v)=%v, want %v", tc.chain, got, tc.want)
+			}
+		})
+	}
+}
